generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  AUDIO
  VIDEO
}

enum StorageKind {
  LOCAL
  S3
}

enum RenditionStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Media {
  id            String           @id @default(cuid())
  title         String
  type          MediaType
  storageKey    String
  storageKind   StorageKind      @default(LOCAL)
  mimeType      String
  size          Int
  uploadedBy    String
  durationSec   Float?
  width         Int?
  height        Int?
  thumbnailKey  String?
  thumbnailKind StorageKind?
  createdAt     DateTime         @default(now())
  rooms         Room[]
  renditions    MediaRendition[]
}

/// One transcoded variant of a Media item (a resolution tier for video, a bitrate
/// tier for audio). Generated in the background after upload; the original upload
/// is always playable immediately regardless of rendition status.
model MediaRendition {
  id          String          @id @default(cuid())
  mediaId     String
  media       Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  label       String // "144p" | "240p" | ... | "1080p" | "128kbps" | "256kbps" | "320kbps"
  status      RenditionStatus @default(PENDING)
  storageKey  String?
  storageKind StorageKind     @default(LOCAL)
  mimeType    String?
  size        Int?
  height      Int?
  bitrateKbps Int?
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([mediaId, label])
}

model Room {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  currentMediaId String?
  currentMedia   Media?    @relation(fields: [currentMediaId], references: [id], onDelete: SetNull)
  isPlaying      Boolean   @default(false)
  positionSec    Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       ChatMessage[]

  @@index([code])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    String
  text      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

/// One row per (anonymous viewer, calendar day, media type) -- accumulates actual
/// playing seconds reported by the player's heartbeat. `lastSeenAt` doubles as the
/// "is this viewer actively streaming right now" signal for the concurrent-stream
/// cap, so a second table isn't needed just for that.
model UsageHeartbeat {
  id          String    @id @default(cuid())
  viewerId    String
  date        String // "YYYY-MM-DD", server clock -- see usageLimits.ts
  mediaType   MediaType
  secondsUsed Int       @default(0)
  lastSeenAt  DateTime  @updatedAt

  @@unique([viewerId, date, mediaType])
  @@index([date, mediaType])
  @@index([lastSeenAt])
}
