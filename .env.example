# Postgres connection string. Portways injects this automatically once a
# Postgres add-on is linked to the project — set a placeholder here for local dev.
DATABASE_URL="postgresql://onestream:onestream@localhost:5432/onestream"

# Shared passcode that gates the whole app for you and your friends.
# Leave unset to disable the gate entirely (not recommended once it's public).
ONESTREAM_PASSCODE="change-me"

# Where uploaded files are written when S3 isn't configured (see below).
# Defaults to ./data/uploads if unset. Not durable across redeploys on Portways —
# see the "Storage" section of README.md.
DATA_DIR=

# --- Optional: S3-compatible object storage (recommended for production) ---
# Uploads and playback stream from here instead of local disk once these are set.
# On Portways: link the project to an "Object Storage (S3)" add-on and all six of
# these are injected automatically, no manual setup needed. Also works with any
# other S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2, MinIO, ...).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to "true" for Portways/R2/MinIO/most non-AWS S3-compatible endpoints.
S3_FORCE_PATH_STYLE=
